{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RawEvan/open-run/main/schema/orbp.v1.schema.json",
  "title": "Open Run Backend Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "backends"],
  "properties": {
    "protocol": { "type": "string", "const": "open-run-backend" },
    "version": { "type": "integer", "const": 1 },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": {
            "type": "string",
            "enum": ["agent-remote", "agent-hook", "direct-llm", "assist", "os-ax"]
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          },
          "label": { "type": "string", "maxLength": 120 }
        }
      }
    }
  }
}
